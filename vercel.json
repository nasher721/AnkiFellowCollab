{
  "buildCommand": "npm run build && npm run package:anki-addon",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": [
        "addons/deckbridge_sync/manifest.json",
        "dist/deckbridge-sync.ankiaddon",
        "openapi.yaml"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
