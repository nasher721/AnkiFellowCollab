SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXPORTS_BUCKET=deckbridge-exports
DECKBRIDGE_REPOSITORY=supabase
MAX_APKG_BYTES=16106127360

# Optional server-side 9Router AI gateway. Do not prefix these with VITE_.
DECKBRIDGE_AI_ENABLED=false
NINEROUTER_URL=
NINEROUTER_KEY=
NINEROUTER_CHAT_MODEL=gpt-4o-mini
NINEROUTER_EMBEDDING_MODEL=text-embedding-3-small
DECKBRIDGE_AI_TIMEOUT_MS=10000
DECKBRIDGE_AI_MODEL_CACHE_TTL_MS=60000

# Self-hosted production hardening. Use only non-secret public URLs here.
DECKBRIDGE_SELF_HOSTED=false
APP_PUBLIC_URL=https://deckbridge.example.com
CORS_ORIGIN=https://deckbridge.example.com
DECKBRIDGE_REQUIRE_HTTPS=true
DECKBRIDGE_TRUST_PROXY=loopback
DECKBRIDGE_TOKEN_TTL_DAYS=90
DECKBRIDGE_WEB_VITALS_LOG=false
